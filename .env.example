# MongoDB Atlas (free M0)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=askpakistan

# Embeddings (Gemini free tier)
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768

# LLM provider: "gemini" (default, free) or "anthropic"
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Retrieval
TOP_K=6
MIN_SCORE=0.55

# Crawler
CRAWL_USER_AGENT=AskPakistanBot/1.0 (+https://ask-pakistan.vercel.app/about; contact: info@ask-pakistan.org)
CRAWL_DELAY_MS=1500
CRAWL_MAX_PAGES_PER_SITE=150

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RATE_LIMIT_PER_MIN=10
